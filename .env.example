# Ku koobi garee faylkan `.env.local` kadibna buuxi furayaasha Firebase.
# Haddii furayaashu madhan yihiin, app-ku wuxuu si caadi ah ugu shaqeeyaa localStorage.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# PIN-ka waalidka. Haddii madhan yahay, default-ku waa 1234.
NEXT_PUBLIC_PARENT_PIN=1234

# Firestore collections: letters, words, children, settings/classroom.
# U oggolow akhriska iyo qorista ururadan marka aad mashruuca Firebase ka shido.
